@version("0.7.0")
namespace malt.elevate

import malt.common

@doc("Daemon → helper: initiate authenticated connection.")
message ElevateHello {
    @doc("Connection nonce supplied as defence in depth alongside peer identity.")
    nonce   @0 : u64
    version @1 : u32
}

@doc("Helper → daemon: authentication result.")
message ElevateHelloAck {
    nonce    @0 : u64
    accepted @1 : bool
    reason   @2 : optional<string>
    version  @3 : u32
}

@doc("Explicit UAC-approved request to enrol one daemon process with the helper.")
message DaemonEnrollmentRequest {
    pid @0 : u32
}

@doc("Helper result for a daemon enrollment request.")
message DaemonEnrollmentResponse {
    accepted @0 : bool
    reason   @1 : optional<string>
}

@doc("An enrolled daemon registers the resources one session may name.")
message SessionEntitlementRequest {
    session_id   @0 : SessionId
    storage_root @1 : string
    pids         @2 : array<u32>
}

@doc("Helper result for a session entitlement registration.")
message SessionEntitlementResponse {
    accepted @0 : bool
    reason   @1 : optional<string>
}

@doc("One environment entry for a helper-owned HCS process launch.")
message HcsEnvironmentEntry {
    key   @0 : string
    value @1 : string
}

@doc("A command that the authenticated daemon asks its entitled helper to run inside an HCS compute system.")
message HcsProcessRequest {
    id                @0 : string
    program           @1 : string
    arguments         @2 : array<string>
    working_directory @3 : optional<string>
    environment       @4 : array<HcsEnvironmentEntry>
    argv0             @5 : optional<string>
}

@doc("HCS process and standard-stream handles duplicated into the authenticated daemon process.")
message HcsProcessLaunch {
    process_id     @0 : u32
    process_handle @1 : u64
    stdin_handle   @2 : u64
    stdout_handle  @3 : u64
    stderr_handle  @4 : u64
}

@doc("Helper-owned contained session created from a resolved immutable image identity.")
message HcsContainerCreated {
    id             @0 : string
    selected_image @1 : optional<string>
}

@doc("Sanitized immutable identity and readiness of one helper-owned Windows image.")
message ProvisionedImage {
    id              @0 : string
    manifest_digest @1 : string
    platform        @2 : string
    os_version      @3 : optional<string>
    ready           @4 : bool
    reason          @5 : optional<string>
    active_sessions @6 : u32
    @doc("Acquired, HCS-prepared, or live-proven helper evidence.")
    readiness_evidence @7 : string
}

@doc("Helper-owned image listing payload.")
message ProvisionedImageList {
    images @0 : array<ProvisionedImage>
}

@non_exhaustive
@doc("Image lifecycle operation. No variant accepts a local path or HCS storage document.")
union ImageOperation {
    Provision @0 { reference @0 : string }
    List      @1 {}
    Inspect   @2 { id @0 : string }
    Remove    @3 { id @0 : string }
}

@doc("Wrapper carrying correlation ID for request/response pairing.")
message ElevateRequestEnvelope {
    request_id @0 : u32
    request    @1 : ElevateRequest
    session_id @2 : SessionId
    nonce      @3 : u64
}

@non_exhaustive
@doc("Typed container operation. The helper renders the OS configuration itself.")
union ContainerOperation {
    Create    @0 { memory_limit_mb @0 : optional<u32>  hostname @1 : optional<string> image_id @2 : optional<string> }
    Start     @1 { id @0 : string }
    Terminate @2 { id @0 : string }
    StartProcess @3 { request @0 : HcsProcessRequest }
}

@non_exhaustive
@doc("Privileged operation request. Platform-specific variants.")
union ElevateRequest {
    # Linux
    CreateNamespace  @0 { pid @0 : u32  tier @1 : IsolationTier }
    MountOverlay     @1 { lower @0 : string  upper @1 : string  merged @2 : string }
    SetCgroup        @2 { pid @0 : u32  memory_mb @1 : u32  cpu_pct @2 : u16 }
    SetupNetns       @3 { pid @0 : u32  bridge @1 : string  veth_host @2 : string  veth_ns @3 : string }
    ApplySeccomp     @4 { pid @0 : u32  policy @1 : bytes }
    # Windows
    CreateSymlink    @5 { target @0 : string  link @1 : string }
    CreateRestrictedToken @6 { pid @0 : u32  tier @1 : IsolationTier }
    ManageHcsContainer @7 { operation @0 : ContainerOperation }
    # macOS
    ApplySeatbelt    @8 { pid @0 : u32  profile @1 : string }
    # Cross-platform
    BindPort         @9 { port @0 : u16  socket_path @1 : string }
    # Helper-owned Windows OCI lifecycle
    ManageImage      @10 { operation @0 : ImageOperation }
}

@non_exhaustive
@doc("Whether an operation was performed, refused, or became unknowable in flight.")
enum OutcomeKind {
    Performed     @0
    Refused       @1
    Indeterminate @2
}

@non_exhaustive
@doc("Machine-readable reason an operation did not complete.")
enum ReasonCode {
    NotImplemented      @0
    UnsupportedPlatform @1
    HelperUnavailable   @2
    NotEntitled         @3
    InvalidParameters   @4
    OsError             @5
    TimedOut            @6
}

@doc("Availability of one operation on this host and build.")
message OperationCapability {
    operation @0 : string
    available @1 : bool
    reason    @2 : optional<ReasonCode>
    detail    @3 : optional<string>
}

@doc("Helper capability report, derived from real implementations and host support.")
message ElevateCapabilities {
    protocol_version @0 : u32
    operations       @1 : array<OperationCapability>
}

@doc("Helper → daemon: operation outcome.")
message ElevateResponse {
    request_id @0 : u32
    kind       @1 : OutcomeKind
    reason     @2 : optional<ReasonCode>
    detail     @3 : optional<string>
    payload    @4 : optional<bytes>
}

@doc("Either side: graceful shutdown.")
message ElevateShutdown {
    reason @0 : string
}
