@version("0.1.0")
namespace malt.persist.session

import malt.common

@doc("Persisted session state. Stored in .vx (text) and optionally .vxb (binary).")
message PersistedSession {
    @doc("Persistence format version. Starts at 1. Read first for version-gating.")
    schema_version @0 : u32
    id             @1 : SessionId
    name           @2 : optional<string>
    layout         @3 : LayoutNode
    focus          @4 : PaneId
    @doc("Key is PaneId as raw u32. See VEXIL_GAPS.md — newtypes cannot be map keys.")
    panes          @5 : map<u32, PersistedPane>
    theme          @6 : optional<ThemeOverride>
    group          @7 : optional<GroupId>
    isolation      @8 : IsolationTier
}

@doc("Persisted pane state within a session.")
@doc("command_blocks is the pane's command execution history, oldest first,")
@doc("capped at the pane's retention bound (1000). Empty for sessions")
@doc("persisted before this field existed. It lives on the message rather")
@doc("than the Shell variant -- history is a pane property, and Compat panes")
@doc("inherit the same shape.")
message PersistedPane {
    cwd            @0 : string
    title          @1 : optional<string>
    pane_type      @2 : PersistedPaneType
    command_blocks @3 : array<PersistedCommandBlock>
}

@doc("One command execution record. Mirrors malt-session::pane::CommandBlock.")
@doc("started_at/finished_at are epoch milliseconds. finished_at and")
@doc("exit_code are both absent while a command is running, and stay absent")
@doc("permanently if the daemon stopped mid-command -- such a record is")
@doc("never reinterpreted as having succeeded.")
@doc("(Field docs are message-level here on purpose: vexilc 0.5.1 attaches a")
@doc("field-level @doc to the *preceding* field. See docs/BACKLOG.md.)")
message PersistedCommandBlock {
    command_id  @0 : u32
    cmd         @1 : string
    started_at  @2 : u64
    finished_at @3 : optional<u64>
    exit_code   @4 : optional<i32>
}

@non_exhaustive
@doc("Discriminated pane type with type-specific restoration data.")
union PersistedPaneType {
    Shell  @0 { shell_path @0 : string  env_snapshot @1 : optional<EnvSnapshot> }
    App    @1 { app_id @0 : string  config @1 : optional<bytes> }
    Compat @2 { program @0 : string  args @1 : array<string> }
}

@non_exhaustive
@doc("Persisted mash shell variable value. Mirrors mash::env::VarValue.")
union PersistedVarValue {
    Str      @0 { value @0 : string }
    Int      @1 { value @0 : i64  formatted @1 : string }
    Arr      @2 { values @0 : array<optional<string>> }
    AssocArr @3 { entries @0 : map<string, string> }
}

@doc("Persisted mash shell variable. Mirrors mash::env::Variable.")
message PersistedVariable {
    value    @0 : PersistedVarValue
    exported @1 : bool
    readonly @2 : bool
    integer  @3 : bool
}

@doc("Persisted mash shell options. Mirrors mash::env::ShellOptions.")
message PersistedShellOptions {
    allexport      @0  : bool
    errexit        @1  : bool
    nounset        @2  : bool
    pipefail       @3  : bool
    xtrace         @4  : bool
    verbose        @5  : bool
    noglob         @6  : bool
    notify         @7  : bool
    monitor        @8  : bool
    noclobber      @9  : bool
    noexec         @10 : bool
    nonlexicalctrl @11 : bool
    hash_cmds      @12 : bool
    nolog          @13 : bool
    sourcepath     @14 : bool
}

@doc("Persisted mash shell environment: exported/non-exported variables,")
@doc("aliases, function source text (re-parsed on restore), directory")
@doc("stack, cwd, and signal traps. Mirrors mash::env::EnvSnapshot. Wired")
@doc("into the daemon's persistence path in feature 003: build_persisted_session")
@doc("writes it and spawn_with_cwd applies it on restore.")
message EnvSnapshot {
    variables @0 : map<string, PersistedVariable>
    options   @1 : PersistedShellOptions
    aliases   @2 : map<string, string>
    @doc("name -> source text, re-parsed on restore")
    functions @3 : map<string, string>
    dir_stack @4 : array<string>
    cwd       @5 : string
    @doc("signal -> action string")
    traps     @6 : map<string, string>
}
